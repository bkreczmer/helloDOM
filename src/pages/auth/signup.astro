---
import PublicLayout from "@/layouts/PublicLayout.astro";
import Card from "@/components/ui/Card.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<PublicLayout title="Rejestracja">
  <div class="mx-auto w-full max-w-sm">
    <h1 class="page-title mb-[18px] text-center">Rejestracja</h1>
    <Card>
      <SignUpForm serverError={error} client:load />
    </Card>
    <p class="mt-4 text-center text-[13px] text-rs-fg-2">
      Masz już konto?{" "}
      <a href="/auth/signin" class="font-semibold text-rs-accent-fg hover:underline">
        Zaloguj się
      </a>
    </p>
  </div>
</PublicLayout>
