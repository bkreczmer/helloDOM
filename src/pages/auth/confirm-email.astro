---
import { CircleCheck, MailCheck } from "lucide-react";
import PublicLayout from "@/layouts/PublicLayout.astro";
import Card from "@/components/ui/Card.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      Icon: CircleCheck,
      heading: "Konto utworzone",
      description: "Twoje konto zostało utworzone. Możesz się teraz zalogować.",
      linkText: "Przejdź do logowania",
    }
  : {
      Icon: MailCheck,
      heading: "Sprawdź skrzynkę",
      description: "Wysłaliśmy link potwierdzający na Twój adres e-mail. Kliknij go, aby aktywować konto.",
      linkText: "Wróć do logowania",
    };

const { Icon } = content;
---

<PublicLayout title={content.heading}>
  <div class="mx-auto w-full max-w-sm">
    <Card>
      <div class="flex flex-col items-center py-4 text-center">
        <Icon className="mb-4 size-12 text-rs-accent" aria-hidden="true" />
        <h1 class="page-title mb-3">{content.heading}</h1>
        <p class="mb-6 text-rs-fg-2">{content.description}</p>
        <a href="/auth/signin" class="text-[13px] font-semibold text-rs-accent-fg hover:underline">
          {content.linkText}
        </a>
      </div>
    </Card>
  </div>
</PublicLayout>
