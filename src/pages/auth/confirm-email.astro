---
import { MailCheck } from "lucide-react";
import PublicLayout from "@/layouts/PublicLayout.astro";
import Card from "@/components/ui/Card.astro";
---

<PublicLayout title="Sprawdź skrzynkę">
  <div class="mx-auto w-full max-w-sm">
    <h1 class="page-title mb-[18px] text-center">Sprawdź skrzynkę</h1>
    <Card>
      <div class="flex flex-col items-center py-4 text-center">
        <MailCheck className="mb-4 size-12 text-rs-accent" aria-hidden="true" />
        <p class="mb-6 text-rs-fg-2">
          Wysłaliśmy link potwierdzający na Twój adres e-mail. Kliknij go, aby aktywować konto.
        </p>
        <a href="/auth/signin" class="text-[13px] font-semibold text-rs-accent-fg hover:underline">
          Wróć do logowania
        </a>
      </div>
    </Card>
  </div>
</PublicLayout>
