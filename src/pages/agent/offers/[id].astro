---
import { ArrowLeft, CircleCheck, Send } from "lucide-react";
import AppLayout from "@/layouts/AppLayout.astro";
import Card from "@/components/ui/Card.astro";
import OfferSummary from "@/components/offers/OfferSummary.astro";
import { ServerError } from "@/components/auth/ServerError";
import { InvitationResponse } from "@/components/agent/InvitationResponse";
import { createClient } from "@/lib/supabase";
import { reportError } from "@/lib/report-error";
import { invitationResponseErrorMessage } from "@/lib/services/invitations";
import { formatOfferDate, parseOfferId, toOffer } from "@/lib/services/offers";
import type { Offer } from "@/types";

// The middleware guarantees a signed-in agent on /agent/*. RLS (offers_select_invited_agent) shows the offer
// only with a pending or accepted invitation of this agent; owner_id is not selected, so no owner data leaks.
const supabase = createClient(Astro.request.headers, Astro.cookies);
const offerId = parseOfferId(Astro.params.id);

// "missing": bad id, no such offer or no active invitation → 404.
let state: "found" | "missing" | "error" = "missing";
let offer: Offer | null = null;
// The agent's active invitation; null when the read failed (the card then shows no actions).
let invitation: { status: "pending" | "accepted"; createdAt: string; respondedAt: string | null } | null = null;
// A failed invitation read still renders the offer (without actions), but the response is a 503.
let invitationFailed = false;

if (offerId && supabase) {
  try {
    const { data, error } = await supabase
      .from("offers")
      .select("id, city, property_type, transaction, price, area_m2, rooms, description, status, created_at")
      .eq("id", offerId)
      .maybeSingle();
    if (error) {
      reportError("error", "agent.offer.read", error, Astro, { offerId });
      state = "error";
    } else if (data) {
      offer = toOffer(data);
      state = "found";
    }
  } catch (e) {
    reportError("error", "agent.offer.read", e, Astro, { offerId });
    state = "error";
  }

  if (offer) {
    // The agent's own active invitation, read through RLS; a failed read drops the date and the actions.
    try {
      const { data, error } = await supabase
        .from("invitations")
        .select("status, created_at, responded_at")
        .eq("offer_id", offer.id)
        .in("status", ["pending", "accepted"])
        .maybeSingle();
      if (error) {
        reportError("error", "agent.offer.invitation", error, Astro, { offerId });
        invitationFailed = true;
      } else if (data && (data.status === "pending" || data.status === "accepted")) {
        invitation = { status: data.status, createdAt: data.created_at, respondedAt: data.responded_at };
      }
    } catch (e) {
      reportError("error", "agent.offer.invitation", e, Astro, { offerId });
      invitation = null;
      invitationFailed = true;
    }
  }
} else if (offerId) {
  reportError("error", "agent.offer.read.config", undefined, Astro, { offerId });
  state = "error";
}

// "missing" stays a 404; a database or config failure is a 503, so it does not look like healthy traffic.
if (state === "missing") {
  Astro.response.status = 404;
} else if (state === "error" || invitationFailed) {
  Astro.response.status = 503;
}

const accepted = Astro.url.searchParams.get("accepted") === "1";
const responseError = invitationResponseErrorMessage(Astro.url.searchParams.get("error"));
---

<AppLayout title={state === "missing" ? "Nie znaleziono oferty" : "Oferta"}>
  <div class="flex w-full max-w-2xl flex-col gap-[18px]">
    {state === "found" && offer ? (
      <>
        {accepted && (
          <p
            role="status"
            class="flex items-center gap-2 rounded-control border border-[color-mix(in_oklab,var(--rs-success)_30%,transparent)] bg-rs-success-soft px-3 py-2 text-[13px] font-semibold text-rs-success-fg"
          >
            <CircleCheck className="size-4 shrink-0" aria-hidden="true" />
            Przyjęto zaproszenie
          </p>
        )}
        <ServerError message={responseError} />
        <OfferSummary offer={offer} />
        <Card title="Zaproszenie">
          <Fragment slot="icon">
            <Send className="size-4" aria-hidden="true" />
          </Fragment>
          {invitation?.status === "accepted" ? (
            <p class="text-[13px] leading-[1.6] text-rs-fg-2">
              {invitation.respondedAt
                ? `Przyjęto zaproszenie ${formatOfferDate(invitation.respondedAt)}. Oferta jest w obsłudze.`
                : "Przyjęto zaproszenie. Oferta jest w obsłudze."}
            </p>
          ) : (
            <p class="text-[13px] leading-[1.6] text-rs-fg-2">
              {invitation
                ? `Zaproszono Cię do tej oferty ${formatOfferDate(invitation.createdAt)}.`
                : "Zaproszono Cię do tej oferty."}
            </p>
          )}
          {invitation?.status === "pending" && <InvitationResponse client:load offerId={offer.id} />}
          <a
            href="/agent"
            class="mt-2 inline-flex items-center gap-1.5 text-[13px] font-semibold text-rs-accent-fg hover:underline"
          >
            <ArrowLeft className="size-4" aria-hidden="true" />
            Wróć do panelu
          </a>
        </Card>
      </>
    ) : state === "missing" ? (
      <Card title="Nie znaleziono oferty">
        <p class="text-[13px] leading-[1.6] text-rs-fg-2">Ta oferta nie istnieje albo nie masz do niej zaproszenia.</p>
        <a
          href="/agent"
          class="mt-2 inline-flex items-center gap-1.5 text-[13px] font-semibold text-rs-accent-fg hover:underline"
        >
          <ArrowLeft className="size-4" aria-hidden="true" />
          Wróć do panelu
        </a>
      </Card>
    ) : (
      <ServerError message="Oferta jest chwilowo niedostępna. Odśwież stronę za chwilę." />
    )}
  </div>
</AppLayout>
