---
import AppLayout from "@/layouts/AppLayout.astro";
import Card from "@/components/ui/Card.astro";
import AgentProfileForm from "@/components/agent/AgentProfileForm";
import { ServerError } from "@/components/auth/ServerError";
import { createClient } from "@/lib/supabase";
import { reportError } from "@/lib/report-error";
import {
  MAX_EXPERIENCE_YEARS,
  MAX_PRICE,
  missingForRanking,
  profileErrorMessage,
  toAgentProfile,
} from "@/lib/services/agent-profile";
import type { AgentProfile } from "@/types";

// The middleware guarantees a signed-in agent on /agent/*.
const userId = Astro.locals.user?.id;
const supabase = createClient(Astro.request.headers, Astro.cookies);

let profile: AgentProfile | null = null;
// A Supabase error, an exception or a missing client is a 503; a missing row keeps today's rendering.
let failed = false;
if (!supabase) {
  reportError("error", "agent.profile.read.config", undefined, Astro);
  failed = true;
} else if (userId) {
  try {
    const { data, error } = await supabase
      .from("profiles")
      .select("cities, property_types, price_min, price_max, experience_years, profile_complete")
      .eq("id", userId)
      .maybeSingle();
    if (error) {
      reportError("error", "agent.profile.read", error, Astro);
      failed = true;
    } else if (data) {
      profile = toAgentProfile(data);
    }
  } catch (e) {
    reportError("error", "agent.profile.read", e, Astro);
    profile = null;
    failed = true;
  }
}
if (failed) {
  Astro.response.status = 503;
}

const serverError = profileErrorMessage(Astro.url.searchParams.get("error"));
const saved = Astro.url.searchParams.has("saved");
---

<AppLayout title="Profil agenta">
  <div class="w-full max-w-2xl">
    {profile ? (
      <Card>
        <AgentProfileForm
          client:load
          initial={profile}
          missing={missingForRanking(profile)}
          limits={{ maxPrice: MAX_PRICE, maxExperienceYears: MAX_EXPERIENCE_YEARS }}
          serverError={serverError}
          saved={saved}
        />
      </Card>
    ) : (
      <ServerError message="Profil jest chwilowo niedostępny. Odśwież stronę za chwilę." />
    )}
  </div>
</AppLayout>
