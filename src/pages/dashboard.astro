---
import AppLayout from "@/layouts/AppLayout.astro";
import Card from "@/components/ui/Card.astro";

const email = Astro.locals.user?.email ?? "";
---

<AppLayout title="Panel">
  <Card title="Witaj">
    <p class="text-[13px] leading-[1.6] text-rs-fg-2">
      Zalogowano jako <span class="font-semibold text-rs-fg">{email}</span>. Tu pojawią się Twoje oferty albo
      zaproszenia.
    </p>
  </Card>
</AppLayout>
