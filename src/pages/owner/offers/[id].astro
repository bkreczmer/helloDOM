---
import { ArrowLeft, CircleCheck, Info, Lock, Pencil, Settings2 } from "lucide-react";
import AppLayout from "@/layouts/AppLayout.astro";
import Card from "@/components/ui/Card.astro";
import { buttonVariants } from "@/components/ui/button";
import OfferSummary from "@/components/offers/OfferSummary.astro";
import InvitationStatusCard from "@/components/owner/InvitationStatusCard.astro";
import RankingList from "@/components/owner/RankingList.astro";
import { DeleteOffer } from "@/components/owner/DeleteOffer";
import { ServerError } from "@/components/auth/ServerError";
import { createClient } from "@/lib/supabase";
import { invitationErrorMessage } from "@/lib/services/invitations";
import {
  formatOfferDate,
  isOfferEditable,
  offerActionErrorMessage,
  parseOfferId,
  toOffer,
  toRankedAgent,
} from "@/lib/services/offers";
import type { Offer, RankedAgent } from "@/types";

// The middleware guarantees a signed-in owner on /owner/*.
const supabase = createClient(Astro.request.headers, Astro.cookies);
const offerId = parseOfferId(Astro.params.id);

// "missing": bad id, someone else's or no such offer (RLS hides other owners' rows) → 404.
let state: "found" | "missing" | "error" = "missing";
let offer: Offer | null = null;
let agents: RankedAgent[] | null = null;
let invitedAt: string | null = null;
let respondedAt: string | null = null;
// responded_at of the latest rejected invitation, shown above the ranking once the offer is back to seeking_agent.
let rejectedAt: string | null = null;

if (offerId && supabase) {
  try {
    const { data, error } = await supabase
      .from("offers")
      .select("id, city, property_type, transaction, price, area_m2, rooms, description, status, created_at")
      .eq("id", offerId)
      .maybeSingle();
    if (error) {
      state = "error";
    } else if (data) {
      offer = toOffer(data);
      state = "found";
    }
  } catch {
    state = "error";
  }

  // Read through RLS first, so "no such offer" (404) and "no matching agents" stay apart.
  // The ranking (and inviting) only applies while the offer is seeking an agent.
  if (offer?.status === "seeking_agent") {
    try {
      const { data, error } = await supabase.rpc("rank_agents_for_offer", { p_offer_id: offer.id });
      agents = error ? null : data.map(toRankedAgent);
    } catch {
      agents = null;
    }
    // The latest rejection, read through RLS; a failed read only drops the notice.
    try {
      const { data, error } = await supabase
        .from("invitations")
        .select("responded_at")
        .eq("offer_id", offer.id)
        .eq("status", "rejected")
        .order("responded_at", { ascending: false })
        .limit(1)
        .maybeSingle();
      rejectedAt = error ? null : (data?.responded_at ?? null);
    } catch {
      rejectedAt = null;
    }
  } else if (offer) {
    // The active invitation, read through RLS; a failed read only drops the date from the status card.
    try {
      const { data, error } = await supabase
        .from("invitations")
        .select("created_at, responded_at")
        .eq("offer_id", offer.id)
        .in("status", ["pending", "accepted"])
        .maybeSingle();
      invitedAt = error ? null : (data?.created_at ?? null);
      respondedAt = error ? null : (data?.responded_at ?? null);
    } catch {
      invitedAt = null;
      respondedAt = null;
    }
  }
} else if (offerId) {
  state = "error";
}

if (state === "missing") {
  Astro.response.status = 404;
}

const created = Astro.url.searchParams.get("created") === "1";
const invited = Astro.url.searchParams.get("invited") === "1";
const updated = Astro.url.searchParams.get("updated") === "1";
// Offer action codes first: invitationErrorMessage turns any code it does not know into its own "unknown" message.
const errorCode = Astro.url.searchParams.get("error");
const actionError = offerActionErrorMessage(errorCode) ?? invitationErrorMessage(errorCode);
---

<AppLayout title={state === "missing" ? "Nie znaleziono oferty" : "Oferta"}>
  <div class="flex w-full max-w-2xl flex-col gap-[18px]">
    {state === "found" && offer ? (
      <>
        {created && (
          <p
            role="status"
            class="flex items-center gap-2 rounded-control border border-[color-mix(in_oklab,var(--rs-success)_30%,transparent)] bg-rs-success-soft px-3 py-2 text-[13px] font-semibold text-rs-success-fg"
          >
            <CircleCheck className="size-4 shrink-0" aria-hidden="true" />
            Zapisano ofertę
          </p>
        )}
        {invited && (
          <p
            role="status"
            class="flex items-center gap-2 rounded-control border border-[color-mix(in_oklab,var(--rs-success)_30%,transparent)] bg-rs-success-soft px-3 py-2 text-[13px] font-semibold text-rs-success-fg"
          >
            <CircleCheck className="size-4 shrink-0" aria-hidden="true" />
            Wysłano zaproszenie
          </p>
        )}
        {updated && (
          <p
            role="status"
            class="flex items-center gap-2 rounded-control border border-[color-mix(in_oklab,var(--rs-success)_30%,transparent)] bg-rs-success-soft px-3 py-2 text-[13px] font-semibold text-rs-success-fg"
          >
            <CircleCheck className="size-4 shrink-0" aria-hidden="true" />
            Zapisano zmiany
          </p>
        )}
        <ServerError message={actionError} />
        <OfferSummary offer={offer} />
        {/* Owner-only actions: OfferSummary is shared with the agent's offer page, so they live here. */}
        <Card title="Zarządzanie ofertą">
          <Fragment slot="icon">
            <Settings2 className="size-4" aria-hidden="true" />
          </Fragment>
          <div class="flex flex-col gap-4">
            {isOfferEditable(offer.status) ? (
              <a
                href={`/owner/offers/${offer.id}/edit`}
                class:list={[buttonVariants({ variant: "default" }), "self-start"]}
              >
                <Pencil className="size-4" aria-hidden="true" />
                Edytuj
              </a>
            ) : (
              <p class="flex items-start gap-2 text-[13px] leading-[1.6] text-rs-fg-2">
                <Lock className="mt-[3px] size-4 shrink-0" aria-hidden="true" />
                Edycja jest zablokowana, bo wysłano zaproszenie do agenta.
              </p>
            )}
            {/* Deletion is allowed in every status (offers_delete_own); the island words the warning per status. */}
            <div class="border-t border-rs-line pt-4">
              <DeleteOffer client:load offerId={offer.id} status={offer.status} />
            </div>
          </div>
        </Card>
        {offer.status === "seeking_agent" ? (
          <>
            {rejectedAt && (
              <p
                role="status"
                class="flex items-center gap-2 rounded-control border border-rs-line bg-rs-surface-2 px-3 py-2 text-[13px] font-semibold text-rs-fg"
              >
                <Info className="size-4 shrink-0" aria-hidden="true" />
                Agent odrzucił zaproszenie {formatOfferDate(rejectedAt)}. Wybierz kolejnego agenta z rankingu.
              </p>
            )}
            <RankingList offerId={offer.id} agents={agents} />
          </>
        ) : (
          <InvitationStatusCard status={offer.status} invitedAt={invitedAt} respondedAt={respondedAt} />
        )}
      </>
    ) : state === "missing" ? (
      <Card title="Nie znaleziono oferty">
        <p class="text-[13px] leading-[1.6] text-rs-fg-2">Ta oferta nie istnieje albo nie należy do Twojego konta.</p>
        <a
          href="/owner"
          class="mt-2 inline-flex items-center gap-1.5 text-[13px] font-semibold text-rs-accent-fg hover:underline"
        >
          <ArrowLeft className="size-4" aria-hidden="true" />
          Wróć do panelu
        </a>
      </Card>
    ) : (
      <ServerError message="Oferta jest chwilowo niedostępna. Odśwież stronę za chwilę." />
    )}
  </div>
</AppLayout>
