---
import Layout from "@/layouts/Layout.astro";
import Sidebar from "@/components/shell/Sidebar.astro";
import AppTopbar from "@/components/shell/AppTopbar.astro";
import Dock from "@/components/shell/Dock.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
const { pathname } = Astro.url;
const { user, profile } = Astro.locals;
// Defence in depth: the redirect lives in middleware (Astro.redirect isn't allowed in layouts).
// A page using this layout outside a gated prefix fails loudly instead of showing the shell without a user and role.
if (!user || !profile) {
  throw new Error(
    `AppLayout requires a signed-in user with a profile: "${pathname}" page must live under a gated prefix in src/lib/route-guard.ts`,
  );
}
const { role } = profile;
const email = user.email ?? "";
---

<Layout title={title}>
  <div class="min-h-screen tablet:grid tablet:grid-cols-[64px_1fr] desktop:grid-cols-[244px_1fr]">
    <Sidebar pathname={pathname} role={role} />
    <div class="flex min-w-0 flex-col">
      <AppTopbar email={email} role={role} />
      <main class="mx-auto flex w-full max-w-[1440px] flex-col gap-[18px] px-3.5 pt-4 pb-[92px] tablet:px-8 tablet:pt-7 tablet:pb-[60px]">
        <h1 class="page-title">{title}</h1>
        <slot />
      </main>
    </div>
  </div>
  <Dock pathname={pathname} role={role} />
</Layout>
