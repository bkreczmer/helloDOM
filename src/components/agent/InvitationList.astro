---
import { ArrowRight, Inbox } from "lucide-react";
import Card from "@/components/ui/Card.astro";
import StatusPill from "@/components/ui/StatusPill.astro";
import { ServerError } from "@/components/auth/ServerError";
import { CITY_LABELS, INVITATION_STATUS_LABELS, PROPERTY_TYPE_LABELS, TRANSACTION_LABELS } from "@/lib/dictionaries";
import { formatOfferDate, formatPrice } from "@/lib/services/offers";
import type { AgentInvitationItem, InvitationStatus, StatusTone } from "@/types";

interface Props {
  /** null when the invitation query failed. */
  invitations: AgentInvitationItem[] | null;
}

const { invitations } = Astro.props;

const STATUS_TONES: Record<InvitationStatus, StatusTone> = {
  pending: "warn",
  accepted: "success",
  rejected: "danger",
};
// No owner data on purpose: the agent sees the offer, not who placed it.
---

<Card title="Zaproszenia">
  <Fragment slot="icon">
    <Inbox className="size-4" aria-hidden="true" />
  </Fragment>
  {invitations === null ? (
    <ServerError message="Lista zaproszeń jest chwilowo niedostępna. Odśwież stronę za chwilę." />
  ) : invitations.length === 0 ? (
    <p class="text-[13px] leading-[1.6] text-rs-fg-2">
      Nie masz jeszcze zaproszeń. Właściciele zapraszają agentów z rankingu top 3 — pełny profil daje Ci w nim miejsce.
    </p>
  ) : (
    <ul class="flex flex-col gap-2.5">
      {invitations.map((invitation) => (
        <li class="flex flex-col gap-2 rounded-control border border-rs-line px-3 py-2.5">
          <div class="flex flex-wrap items-start justify-between gap-2">
            {invitation.offer ? (
              <h3 class="min-w-0 font-display text-[13.5px] font-semibold break-words text-rs-fg">
                {CITY_LABELS[invitation.offer.city]} · {PROPERTY_TYPE_LABELS[invitation.offer.propertyType]} ·{" "}
                {TRANSACTION_LABELS[invitation.offer.transaction]}
              </h3>
            ) : (
              <h3 class="min-w-0 font-display text-[13.5px] font-semibold text-rs-fg">Oferta niedostępna</h3>
            )}
            <StatusPill tone={STATUS_TONES[invitation.status]}>
              {INVITATION_STATUS_LABELS[invitation.status]}
            </StatusPill>
          </div>
          <div class="flex flex-wrap items-end justify-between gap-2">
            <div class="flex flex-col gap-0.5">
              {invitation.offer && (
                <span class="font-numeric text-[14px] font-bold whitespace-nowrap tabular-nums text-rs-fg">
                  {formatPrice(invitation.offer.price)}
                </span>
              )}
              <span class="text-[11.5px] text-rs-fg-2">
                Zaproszono <time datetime={invitation.createdAt}>{formatOfferDate(invitation.createdAt)}</time>
              </span>
            </div>
            {invitation.offer && (
              <a
                href={`/agent/offers/${invitation.offer.id}`}
                class="inline-flex items-center gap-1.5 text-[13px] font-semibold text-rs-accent-fg hover:underline"
              >
                Zobacz ofertę
                <ArrowRight className="size-4" aria-hidden="true" />
              </a>
            )}
          </div>
        </li>
      ))}
    </ul>
  )}
</Card>
