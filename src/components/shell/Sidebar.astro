---
import { cn } from "@/lib/utils";
import { isActive, navConfig } from "@/components/shell/nav";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
---

<aside class="sticky top-0 hidden h-screen flex-col gap-6 border-r border-rs-line bg-rs-surface px-3.5 py-[22px] tablet:flex">
  <a
    href="/dashboard"
    class="hidden px-2.5 font-display text-[18px] font-bold text-rs-accent-fg desktop:block dark:text-rs-fg"
  >
    helloDOM
  </a>
  <nav aria-label="Główna nawigacja">
    <ul class="flex flex-col gap-1">
      {navConfig.map(({ href, label, icon: Icon }) => {
        const active = isActive(pathname, href);
        return (
          <li>
            <a
              href={href}
              title={label}
              aria-current={active ? "page" : undefined}
              class:list={[
                "flex items-center justify-center gap-2.5 rounded-sm px-2.5 py-[9px] font-display text-[13.5px] transition-colors duration-[120ms] ease-rs desktop:justify-start",
                active
                  ? "bg-rs-surface-2 font-semibold text-rs-fg"
                  : "font-medium text-rs-fg-2 hover:bg-rs-surface-2 hover:text-rs-fg",
              ]}
            >
              <Icon className={cn("size-4 shrink-0", active && "text-rs-accent")} aria-hidden="true" />
              <span class="sr-only desktop:not-sr-only">{label}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</aside>
